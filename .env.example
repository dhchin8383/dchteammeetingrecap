# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic (writes the summary + infographic content) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Slack (posts the recap to #dchlounge) ---
# Bot token for a Slack app with scopes: chat:write, files:write
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The #dchlounge channel ID (not the name) — find it in Slack: channel name > View channel details > bottom of the panel.
SLACK_CHANNEL_ID=C0XXXXXXXXX
# Slack has no "@everyone" — <!channel> is the equivalent and notifies everyone in the channel.
SLACK_NOTIFY_TAG=<!channel>

# --- Company branding shown on the infographic ---
COMPANY_NAME=Dan Chin Homes
COMPANY_KICKER=Weekly Team Recap
COMPANY_SUBLINE=McFarland · Madison · Dane County
COMPANY_TAGLINE=Let's keep selling houses.
COMPANY_TAGWORDS=Hustle · Mindset · Accountability · Adaptability

# Advanced/optional: only set this if you need to point at a specific Chromium binary
# instead of the one Playwright installed for you (most people should leave this blank).
PLAYWRIGHT_CHROMIUM_PATH=

# --- Server ---
PORT=4747
# Public base URL Slack/dchhub.com should use to reach this app on your LAN, e.g. http://192.168.1.50:4747
# Leave blank to auto-detect from the request, but setting it explicitly is more reliable.
PUBLIC_BASE_URL=
